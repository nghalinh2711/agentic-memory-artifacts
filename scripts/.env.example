# Copy to .env (in the dir you run the scripts from, or scripts/.env).
# Only these keys are read from .env / the environment.
# Student credentials are generated by setup_student.py and stored in generated_users.csv.

ARTEMIS_URL=https://artemis-benchmark.vdl-ws.sdq.kastel.kit.edu
ARTEMIS_ADMIN_USER=admin
# Treat .env as a secret file (chmod 600) if you put the admin password here.
ARTEMIS_ADMIN_PASSWORD=changeme
ARTEMIS_COURSE_ID=42

# ---- clone_student_repos.py ----
ARTEMIS_GIT_HOST=artemis-benchmark.vdl-ws.sdq.kastel.kit.edu
ARTEMIS_STUDENT_USER=your-student-username
ARTEMIS_STUDENT_TOKEN=your-personal-access-token
